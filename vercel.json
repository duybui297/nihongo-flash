{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/products/nihongo-flash/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/products/nihongo-flash/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/products/nihongo-flash",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
