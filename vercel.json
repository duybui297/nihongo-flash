{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/products/nihongo-flash/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/products/nihongo-flash/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/products/nihongo-flash",
      "destination": "/index.html"
    },
    {
      "source": "/products/nihongo-flash/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/:match*",
      "destination": "/index.html"
    }
  ]
}
